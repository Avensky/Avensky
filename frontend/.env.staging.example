# Copy to frontend/.env.staging AFTER deploying a separate staging server.
# This is only an example hostname; it is not live until DNS, Caddy and
# the isolated staging container have been configured and tested.
VITE_DEPLOY_ENV=staging
VITE_RUST_WS_URL=wss://api-staging.avensky.com/ws/

# Set to the numeric ID of the staging shared world to enable Open World.
# VITE_OPEN_WORLD_ID=

# The frontend uses the same-origin /__staging-assets/ route.
# Configure the Lightsail bucket and credentials on the private gateway.
