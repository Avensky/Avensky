{
  "name": "avensky",
  "private": true,
  "scripts": {
    "check": "concurrently -n frontend,rust \"npm:check:frontend\" \"npm:check:rust\"",
    "check:frontend": "npm --prefix frontend run lint && npm --prefix frontend run typecheck && npm run wardrobe:layers:check",
    "check:cargo": "cargo --version && rustc --version",
    "check:rust": "cd avenlab-server && cargo check",
    "wardrobe:catalog": "node frontend/scripts/discover-wardrobe-garments.mts --write",
    "wardrobe:catalog:check": "node frontend/scripts/discover-wardrobe-garments.mts --check",
    "dev": "concurrently -k -n frontend,rust \"npm:dev:frontend\" \"npm:dev:rust\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:rust": "cd avenlab-server && cargo run",
    "dev:rust:fast": "cd avenlab-server && cargo run --release",
    "start:rust": "cd avenlab-server && cargo run --release",
    "dev:fast": "concurrently -k -n frontend,rust \"npm:dev:frontend\" \"npm:dev:rust:fast\"",
    "dev:rust:watch": "cd avenlab-server && cargo watch -x run",
    "lint": "npm run check",
    "install:all": "npm run install:frontend && npm run install:rust",
    "install:frontend": "npm --prefix frontend install",
    "install:cargo": "winget install -e --id Rustlang.Rustup --accept-package-agreements --accept-source-agreements",
    "install:cargo:linux": "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y",
    "install:rust": "cargo fetch --manifest-path avenlab-server/Cargo.toml",
    "install:rust-tools": "cargo install cargo-watch",
    "build": "npm --prefix frontend run build",
    "wardrobe:layers:check": "node packages/wardrobe-catalog/validate-layer-rules.mjs && node --test frontend/tests/wardrobe-layer-manifest.test.mjs frontend/tests/wardrobe-layer-resolver.test.mjs && npm run wardrobe:legacy:check && npm run wardrobe:preview:check",
    "wardrobe:legacy:check": "node --test frontend/tests/wardrobe-layer-migration.test.mjs",
    "wardrobe:preview:check": "node --test frontend/tests/wardrobe-layer-preview.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^9.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
